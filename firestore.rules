// Regras de segurança recomendadas para o projeto BM_Odonto
// - Ajuste conforme a modelagem real dos documentos (em particular: campos `authUid`, `userId`, `patientAuthUid`, `patientEmail`).
// - Estas regras servem como ponto de partida seguro: exigem autenticação e limitam operações sensíveis.
// - Implemente migração para garantir que cada documento relevante contenha um campo ligado ao Firebase Auth UID
//   (ex.: `authUid`) para permitir verificações confiáveis nas regras.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Busca um documento em users cujo id seja igual ao auth.uid.
    // OBS: só funcionará se houver um documento `users/{authUid}`. Se seu projeto usa ids diferentes,
    // adapte a modelagem (recomendo salvar `authUid` dentro do documento do usuário e garantir um doc por uid).
    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
             : null;
    }

    function isStaff() {
      let role = getUserRole();
      return role == 'dentist' || role == 'attendant' || role == 'admin';
    }

    function isAdmin() {
      let role = getUserRole();
      return role == 'attendant' || role == 'admin';
    }

    function hasUsersPermission() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'attendant'
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions is list
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.hasAny(['users'])
          )
        );
    }

    function isRealAdmin() {
      return getUserRole() == 'admin';
    }

    function grantsUsersPermission(data) {
      return data.get('permissions', []) is list && data.get('permissions', []).hasAny(['users']);
    }

    // Perfil que o próprio usuário pode criar para si (cadastro ou migração do login antigo):
    // paciente, ou dentista que já tem cadastro em `dentists` com o mesmo e-mail do login.
    // Ninguém consegue se criar como admin ou atendente.
    function isAllowedSelfProfile(userId) {
      let data = request.resource.data;
      let dentistId = data.get('legacyId', userId);
      return (request.auth.uid == userId || data.get('authUid', '') == request.auth.uid)
        && !grantsUsersPermission(data)
        && (
          data.role == 'patient'
          || (
            data.role == 'dentist'
            && exists(/databases/$(database)/documents/dentists/$(dentistId))
            && get(/databases/$(database)/documents/dentists/$(dentistId)).data.email == request.auth.token.email
          )
        );
    }

    function isNotificationTypeAllowed(type) {
      return type == 'success' || type == 'info' || type == 'error' || type == 'warning';
    }

    // --- Notifications: acesso restrito ao proprietário ---
    match /notifications/{notifId} {
      // Criação: o próprio usuário pode criar lembretes próprios, e o criador de um
      // agendamento pode gerar a notificação do dentista associado a esse appointment.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['userId', 'message', 'type', 'createdAt', 'read'])
                    && request.resource.data.keys().hasOnly(['userId', 'message', 'type', 'appointmentId', 'createdAt', 'read'])
                    && request.resource.data.read == false
                    && isNotificationTypeAllowed(request.resource.data.type)
                    && (
                      request.auth.uid == request.resource.data.userId
                      || (
                        request.resource.data.appointmentId is string
                        && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
                        && request.resource.data.userId == getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.dentistAuthUid
                        && (
                          isStaff()
                          || request.auth.uid == getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.patientAuthUid
                        )
                      )
                    );

      // Leitura: somente o usuário destino (proprietário) pode ler suas notificações
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;

      // Atualização: permitir apenas marcar como lida (campo `read`) pelo proprietário
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;

      // Não permitir exclusão pelo cliente
      allow delete: if false;
    }

    // --- Users ---
    match /users/{userId} {
      // Criação: admin; gestor de usuários (sem criar admin nem conceder a permissão `users`);
      // ou o próprio usuário criando o seu perfil de paciente/dentista (ver isAllowedSelfProfile).
      allow create: if isSignedIn() && (
        isRealAdmin()
        || (
          hasUsersPermission()
          && request.resource.data.role in ['patient', 'dentist', 'attendant']
          && !grantsUsersPermission(request.resource.data)
          && request.resource.data.cpf is string
          && request.resource.data.cpf.matches('^[0-9]{11}$')
        )
        || isAllowedSelfProfile(userId)
      );

      // Leitura de documento único: o próprio usuário, por authUid, por email, ou staff
      allow get: if isSignedIn() && (
        request.auth.uid == userId
        || resource.data.authUid == request.auth.uid
        || resource.data.email == request.auth.token.email
        || isStaff()
      );

      // Listagem: staff vê todos; os demais só os próprios documentos (consulta por authUid ou
      // pelo próprio e-mail, usada no login).
      allow list: if isSignedIn() && (
        isStaff()
        || resource.data.authUid == request.auth.uid
        || resource.data.email == request.auth.token.email
      );

      // Atualização:
      // - admin: qualquer campo;
      // - gestor de usuários: não mexe em admins nem em papel/permissões;
      // - o próprio usuário: não altera papel nem permissões, e só pode vincular o próprio authUid.
      allow update: if isSignedIn() && (
        isRealAdmin()
        || (
          hasUsersPermission()
          && resource.data.role != 'admin'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])
        )
        || (
          (request.auth.uid == userId || resource.data.authUid == request.auth.uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authUid'])
            || request.resource.data.authUid == request.auth.uid
          )
        )
      );

      // Exclusão: admin; gestor de usuários apenas de pacientes.
      allow delete: if isSignedIn() && (
        isRealAdmin()
        || (hasUsersPermission() && resource.data.role == 'patient')
      );
    }

    // --- Patients (prontuários) ---
    match /patients/{patientId} {
      // Criação por staff
      allow create: if isSignedIn() && isStaff();

      // Leitura: staff ou o próprio paciente (quando o documento contém `authUid` ou email)
      allow read: if isSignedIn() && (isStaff() || request.auth.uid == resource.data.authUid || request.auth.token.email == resource.data.email);

      // Atualização: staff; o próprio paciente só altera os dados de contato
      // (e pode apagar uma senha antiga armazenada, nunca gravar uma).
      allow update: if isSignedIn() && (
        isStaff()
        || (
          request.auth.uid == resource.data.authUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'phone', 'address', 'cep', 'street', 'number',
            'neighborhood', 'city', 'state', 'photoURL', 'password'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['password'])
            || !('password' in request.resource.data)
          )
        )
      );

      allow delete: if isSignedIn() && isAdmin();
    }

    // --- Dentists ---
    match /dentists/{dentistId} {
      allow create: if isSignedIn() && isAdmin();
      allow read: if isSignedIn() && (isStaff() || request.auth.uid == resource.data.authUid);
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    // --- Attendants ---
    match /attendants/{attendantId} {
      allow create, read, update, delete: if isSignedIn() && hasUsersPermission();
    }

    // --- Appointments ---
    // Regras conservadoras: staff tem controle; pacientes autenticados podem criar/ler/atualizar seus próprios agendamentos
    // Para isso o documento de agendamento deve conter `patientAuthUid` ou `patientEmail` (recomendado adicionar `patientAuthUid`).
    match /appointments/{aptId} {
      // Criação: apenas a equipe (o portal do paciente não cria agendamentos).
      allow create: if isSignedIn() && isStaff();

      allow read: if isSignedIn()
                  && (isStaff() || request.auth.uid == resource.data.patientAuthUid || request.auth.token.email == resource.data.patientEmail);

      // Atualização: equipe; o paciente só confirma ou cancela o próprio agendamento.
      allow update: if isSignedIn() && (
        isStaff()
        || (
          (request.auth.uid == resource.data.patientAuthUid || request.auth.token.email == resource.data.patientEmail)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['confirmed', 'cancelled', 'Confirmado', 'Cancelado']
        )
      );

      allow delete: if isSignedIn() && isStaff();
    }

    // --- Treatments ---
    match /treatments/{tId} {
      allow read: if isSignedIn() && (isStaff() || request.auth.uid == resource.data.patientAuthUid);
      allow create, update: if isSignedIn() && isStaff();
      allow delete: if isSignedIn() && isStaff();
    }

    // --- Documents (arquivos do prontuário) ---
    match /documents/{docId} {
      allow create: if isSignedIn() && (isStaff() || request.auth.uid == request.resource.data.patientAuthUid);
      allow read: if isSignedIn() && (isStaff() || request.auth.uid == resource.data.patientAuthUid);
      allow update, delete: if isSignedIn() && isStaff();
    }

    // --- Inventário, anúncios, agendas, movimentos, logs ---
    match /inventory/{itemId} {
      allow read, write: if isSignedIn() && isStaff();
    }

    match /announcements/{id} {
      // Anúncios podem ser públicos para usuários autenticados ou públicos em geral dependendo da necessidade
      allow read: if true; // se preferir proteger, troque para `isSignedIn()`
      allow create, update, delete: if isSignedIn() && isStaff();
    }

    match /schedules/{id} { allow read, write: if isSignedIn() && isStaff(); }
    match /movements/{id} { allow read, write: if isSignedIn() && isStaff(); }

    match /audit_logs/{id} {
      allow create: if isSignedIn() && isStaff();
      allow read: if isSignedIn() && isStaff();
      allow update, delete: if false;
    }

    match /settings/{id} {
      allow read: if isSignedIn() && isStaff();
      allow write: if isSignedIn() && isAdmin();
    }

    // --- Deny por padrão para qualquer outro caminho ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
