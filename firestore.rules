rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerByEmail(userDoc) {
      return isAuthenticated() && request.auth.token.email == userDoc.email;
    }

    // Users collection
    match /users/{userId} {
      // AVISO: Esta coleção está temporariamente pública porque a aplicação não utiliza Firebase Auth.
      // Implemente Firebase Auth para restringir o acesso.
      allow read, create, update, delete: if true;
    }

    // Patients collection
    match /patients/{patientId} {
      allow read, create, update, delete: if true;
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read, create, update, delete: if true;
    }

    // Treatments collection
    match /treatments/{treatmentId} {
      allow read, create, update, delete: if true;
    }

    // Dentists collection
    match /dentists/{dentistId} {
      allow read, create, update, delete: if true;
    }

    // Attendants collection
    match /attendants/{attendantId} {
      allow read, create, update, delete: if true;
    }

    // Documents collection
    match /documents/{documentId} {
      allow read, create, update, delete: if true;
    }

    // Inventory collection
    match /inventory/{itemId} {
      allow read, create, update, delete: if true;
    }

    // Movements collection
    match /movements/{movementId} {
      allow read, create, update, delete: if true;
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read, create, update, delete: if true;
    }

    // Schedules collection
    match /schedules/{scheduleId} {
      allow read, create, update, delete: if true;
    }

    // Audit Logs collection
    match /audit_logs/{logId} {
      allow read, create, update, delete: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, create, update, delete: if true;
    }
  }
}
