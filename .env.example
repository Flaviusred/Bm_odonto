# Exemplo de variáveis de ambiente necessárias para deploy
# Não coloque segredos em repositórios públicos.

# Servidor
PORT=3000
NODE_ENV=production

# Firebase (opcional) - colocar o JSON inteiro como uma string
# FIREBASE_SERVICE_ACCOUNT should be a single-line JSON string (escape newlines)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# Google OAuth (para integração com Google Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-deploy-domain.com/auth/google/callback

# SMTP / Email
SMTP_PROVIDER=gmail
EMAIL_USER=your@gmail.com
EMAIL_PASS=app-password-or-smtp-password
EMAIL_FROM=Bravo Odonto <no-reply@yourdomain.com>
# Alternatively for generic SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASS=smtp-pass

# CBMPB API token (if used)
CBMPB_API_TOKEN=Bearer xxxxx

# Site URL used in email links
SITE_URL=https://your-frontend-domain.vercel.app

# Gemini (AI) key
GEMINI_API_KEY=your-gemini-key

# Optional
DOMAIN=yourdomain.com
SENDGRID_API_KEY=
# Email Configuration (Nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# SMS Configuration (Twilio)
TWILIO_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE=your-twilio-phone-number

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# API CBMPB (Corpo de Bombeiros Militar da Paraíba)
# Token de autenticação para busca de militares e dependentes
# Formato: Bearer SEU_TOKEN_AQUI
CBMPB_API_TOKEN=Authorization:
# Gemini AI (Google)
GEMINI_API_KEY=your-gemini-api-key


